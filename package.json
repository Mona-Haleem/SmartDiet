{
  "name": "smartdiet",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:python": "python -m pytest",
    "test:python:coverage": "python -m pytest --cov --cov-report=term --cov-report=html",
    "test:performance": "python -m pytest -m performance",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:mobile": "playwright test --project=mobile-chromium",
    "test:e2e:all": "playwright test",
    "test:a11y": "playwright test --project=chromium --grep @a11y",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test:python && npm run test && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mona-Haleem/SmartDiet.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Mona-Haleem/SmartDiet/issues"
  },
  "homepage": "https://github.com/Mona-Haleem/SmartDiet#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@jest/globals": "^30.2.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.2",
    "alpinejs": "^3.17.5",
    "babel-jest": "^30.2.0",
    "bootstrap": "^5.3.3",
    "chart.js": "^4.6.1",
    "htmx.org": "^2.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0"
  }
}
